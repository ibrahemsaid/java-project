<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.inventory.controller.LoginController"
           prefWidth="480.0"
           prefHeight="560.0"
           minWidth="420.0"
           minHeight="500.0"
           styleClass="login-root">
    <VBox alignment="CENTER_LEFT" maxWidth="340.0" spacing="14.0" styleClass="login-card">
        <padding>
            <Insets top="36.0" right="34.0" bottom="36.0" left="34.0"/>
        </padding>

        <Label text="Inventory Management System" styleClass="app-title" wrapText="true"/>
        <Label text="Welcome back. Sign in to manage your inventory."
               styleClass="welcome-text" wrapText="true"/>

        <VBox spacing="7.0">
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField"
                       promptText="Enter your username"
                       styleClass="input-field"
                       onAction="#handleLogin"/>
        </VBox>

        <VBox spacing="7.0">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           styleClass="input-field"
                           onAction="#handleLogin"/>
        </VBox>

        <Label fx:id="feedbackLabel"
               minHeight="36.0"
               wrapText="true"
               styleClass="feedback-label"/>
        <Button fx:id="loginButton"
                text="Sign in"
                maxWidth="Infinity"
                defaultButton="true"
                onAction="#handleLogin"
                styleClass="login-button"/>
    </VBox>
</StackPane>
