<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inventory.controller.CategoryController"
      spacing="18.0"
      styleClass="category-page">
    <padding>
        <Insets top="4.0" right="0.0" bottom="4.0" left="0.0"/>
    </padding>

    <Label text="Categories" styleClass="page-title"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="category-actions">
        <Button fx:id="addButton"
                text="Add"
                onAction="#handleAddCategory"
                styleClass="category-primary-button"/>
        <Button fx:id="editButton"
                text="Edit"
                onAction="#handleEditCategory"
                styleClass="category-secondary-button"/>
        <Button fx:id="deleteButton"
                text="Delete"
                onAction="#handleDeleteCategory"
                styleClass="category-danger-button"/>
        <Button fx:id="refreshButton"
                text="Refresh"
                onAction="#handleRefreshCategories"
                styleClass="category-secondary-button"/>
    </HBox>

    <TableView fx:id="categoryTable"
               VBox.vgrow="ALWAYS"
               styleClass="category-table">
        <columns>
            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="110.0"
                         sortable="true"/>
            <TableColumn fx:id="nameColumn"
                         text="Name"
                         prefWidth="520.0"
                         sortable="true"/>
        </columns>
        <placeholder>
            <Label text="No categories found."/>
        </placeholder>
    </TableView>

    <Label fx:id="statusLabel" styleClass="category-status"/>
</VBox>
