<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.controller.MainController"
            prefWidth="1100.0"
            prefHeight="720.0"
            styleClass="main-root">
    <left>
        <VBox prefWidth="248.0" spacing="28.0" styleClass="sidebar">
            <padding>
                <Insets top="28.0" right="18.0" bottom="20.0" left="18.0"/>
            </padding>

            <VBox spacing="4.0" styleClass="brand-block">
                <Label text="INVENTORY" styleClass="brand-eyebrow"/>
                <Label text="Management" styleClass="brand-name"/>
            </VBox>

            <VBox spacing="7.0">
                <Label text="WORKSPACE" styleClass="navigation-heading"/>
                <Button fx:id="dashboardButton"
                        text="Dashboard"
                        maxWidth="Infinity"
                        onAction="#handleDashboardNavigation"
                        styleClass="nav-button"/>
                <Button fx:id="productsButton"
                        text="Products"
                        maxWidth="Infinity"
                        onAction="#handleProductsNavigation"
                        styleClass="nav-button"/>
                <Button fx:id="categoriesButton"
                        text="Categories"
                        maxWidth="Infinity"
                        onAction="#handleCategoriesNavigation"
                        styleClass="nav-button"/>
                <Button fx:id="salesButton"
                        text="Sales &amp; Invoices"
                        maxWidth="Infinity"
                        onAction="#handleSalesNavigation"
                        styleClass="nav-button"/>
                <Button fx:id="stockMovementsButton"
                        text="Stock Movements"
                        maxWidth="Infinity"
                        onAction="#handleStockMovementsNavigation"
                        styleClass="nav-button"/>
                <Button fx:id="usersButton"
                        text="Users"
                        maxWidth="Infinity"
                        onAction="#handleUsersNavigation"
                        styleClass="nav-button"/>
                <Button fx:id="reportsButton"
                        text="Reports"
                        maxWidth="Infinity"
                        onAction="#handleReportsNavigation"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Inventory Management System" styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-header">
            <padding>
                <Insets top="14.0" right="30.0" bottom="14.0" left="30.0"/>
            </padding>
            <Label text="Workspace" styleClass="header-context"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox spacing="3.0" alignment="CENTER_RIGHT">
                <Label fx:id="usernameLabel" styleClass="header-username"/>
                <Label fx:id="roleLabel" styleClass="header-role"/>
            </VBox>
            <Button fx:id="logoutButton"
                    text="Log out"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="workspace-scroll">
            <content>
                <VBox fx:id="contentArea" spacing="22.0" styleClass="workspace-content">
                    <padding>
                        <Insets top="38.0" right="38.0" bottom="38.0" left="38.0"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
